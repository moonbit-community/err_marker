  0x93B, 0x93E, 0x942, 0x945, 0x949, 0x94B, 0x94E, 0x951, 0x954, 0x956, 0x958, 0x95B,
  0x95E, 0x960,
]

///|
test "GraphemeBreakTest.txt: every case" {
  let cases = conformance_code_point_offsets.length() - 1
  assert_eq(cases, 853)
  for i in 0..<cases {
    let text = StringBuilder()
    for
      k in conformance_code_point_offsets[i]..<conformance_code_point_offsets[i +
      1] {
      text.write_char(Int32::unsafe_to_char(conformance_code_points[k]))
    }
    let expected = []
    for
      k in conformance_boundary_offsets[i]..<conformance_boundary_offsets[i + 1] {
      expected.push(conformance_boundaries[k])
    }
    let actual = @ucd.cluster_boundaries(text.to_string())
    assert_eq((i, actual), (i, expected))
  }
}
